<!DOCTYPE html>
<html lang="{{ html_lang }}">
<head>
<meta charset="utf-8">
<meta name="generator" content="pdf-ocr-bench">
<meta name="ocr.engine" content="{{ engine_name }}">
<meta name="pdf.options.pageWidth" content="{{ '%.4f' % width_mm }}">
<meta name="pdf.options.pageHeight" content="{{ '%.4f' % height_mm }}">
<title>Page {{ page_num + 1 }}</title>
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  .page {
    position: relative;
    width: {{ '%.2f' % width_pt }}pt;
    height: {{ '%.2f' % height_pt }}pt;
    overflow: hidden;
  }
  .word {
    position: absolute;
    color: #000;
    font-family: {{ font_family }};
    line-height: 1;
    white-space: pre;
  }
  /* debug mode: outline every word box */
  .page.debug .word {
    border: 1px solid #f00;
  }
</style>
</head>
<body>
<div class="page" id="page-{{ page_num }}">
  {% for word in words %}
  {% set st = style(word) %}
  <span class="word" style="left: {{ '%.4f' % (word.bbox.x * 100) }}%; top: {{ '%.4f' % (st.top * 100) }}%; width: {{ '%.4f' % (word.bbox.w * 100) }}%; height: {{ '%.4f' % (word.bbox.h * 100) }}%; font-size: {{ '%.2f' % st.font_size_pt }}pt;" data-confidence="{{ '%.3f' % word.confidence }}">{{ word.text | e }}{{ st.suffix }}</span>
  {% endfor %}
</div>
<script>
  // Toggle debug mode: press 'd' to outline the word boxes
  document.addEventListener('keydown', e => {
    if (e.key === 'd') document.querySelector('.page').classList.toggle('debug');
  });
</script>
</body>
</html>
